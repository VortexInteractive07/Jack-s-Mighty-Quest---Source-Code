/// @description Returns a random splash text or a holiday-specific override.
function scr_title_splash() {
    var _today = date_current_datetime();
    var _m = date_get_month(_today);
    var _d = date_get_day(_today);

    // ====================================================================
    // 1. SPECIAL OCCASIONS & HOLIDAY OVERRIDES
    // ====================================================================
    // New Year's Day (Jan 1)
    if (_m == 1 && _d == 1) return "Happy New Year! Here's to a year of great code!";
    
    // Valentine's Day (Feb 14)
    if (_m == 2 && _d == 14) return "So this is love? Happy Valentine's Day!";
    
    // April Fools' Day (Apr 1)
    if (_m == 4 && _d == 1) return "FATAL ERROR 404: Game engine destroyed! (Just kidding)";
    
    // Maldivian Independence Day (Jul 26)
    if (_m == 7 && _d == 26) return "Happy Independence Day!";
    
    // Halloween (Oct 31)
    if (_m == 10 && _d == 31) return "Spooky season! Wave 666 skeleton horde incoming!";
    
    // Christmas Eve & Christmas (Dec 24 - Dec 25)
    if (_m == 12 && (_d == 24 || _d == 25)) return "Merry Christmas! Enjoy the pixelated festivities!";
    
    // New Year's Eve (Dec 31)
    if (_m == 12 && _d == 31) return "Counting down to a brand new year of retro gaming!";

    // ====================================================================
    // 2. STANDARD SPLASH POOL
    // ====================================================================
    static _splashes = [
        // AETHERIA, CELESTIA & JMQ EXPANDED LORE
        "Save Aetheria from Victor Schadenfreude's reign!",
        "Celestia's skies are calling for a hero!",
        "Defend Aetheria's magic with everything you've got!",
        "Victor Schadenfreude shall not control Celestia!",
        "Jack steps foot into Aetheria once again!",
        "The sacred skies of Celestia shine bright!",
        "Victor's evil shadows stretch across Aetheria!",
        "Protect the realm of Celestia at all costs!",
        "Jack vs. Victor Schadenfreude: The Final Showdown!",
        "Aetheria's destiny lies in your hands!",
        "Jack charges his pixel sword in Aetheria!",
        "Celestia shines brighter than 1080p graphics!",
        "Victor Schadenfreude is sweating at 60 FPS!",
        "The Floating Isles of Celestia await!",
        "Victor's airships detected over Aetheria!",
        "Jack jumps into the dimension portal!",
        "Celestia's ancient core powers the world!",
        "Beat Victor before the final boss track loops!",
        "Aetheria's crystal guardians lend Jack power!",
        "Sky-high platforms test your platforming skills!",
        "Victor Schadenfreude underestimated Jack's resolve!",
        "Celestia will never fall to corporate villains!",
        "Aetherian magic meets classic 8-bit logic!",
        "Jack dashes past Victor's shadow sentries!",
        "The realm of Celestia is saved by pure skill!",

        // GENUINE HALAL & ISLAMIC MEMES / QUOTES
        "I saw Prophet Muhammed PBUH, eating chicken - [Sahih al-Bukhari 5517]",
