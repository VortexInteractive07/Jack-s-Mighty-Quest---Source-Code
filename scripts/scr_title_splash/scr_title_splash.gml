/// @description Returns a random splash text or a holiday-specific override.
function scr_title_splash() {
    var _today = date_current_datetime();
    var _m = date_get_month(_today);
    var _d = date_get_day(_today);

    // ====================================================================
    // 1. SPECIAL OCCASIONS & HOLIDAY OVERRIDES
    // ====================================================================
    // New Year's Day (Jan 1)
    if (_m == 1 && _d == 1) return "Happy New Year! Here's to a year of great code!";
    
    // Valentine's Day (Feb 14)
    if (_m == 2 && _d == 14) return "So this is love? Happy Valentine's Day!";
    
    // April Fools' Day (Apr 1)
    if (_m == 4 && _d == 1) return "FATAL ERROR 404: Game engine destroyed! (Just kidding)";
    
    // Maldivian Independence Day (Jul 26)
    if (_m == 7 && _d == 26) return "Happy Independence Day!";
    
    // Halloween (Oct 31)
    if (_m == 10 && _d == 31) return "Spooky season! Wave 666 skeleton horde incoming!";
    
    // Christmas Eve & Christmas (Dec 24 - Dec 25)
    if (_m == 12 && (_d == 24 || _d == 25)) return "Merry Christmas! Enjoy the pixelated festivities!";
    
    // New Year's Eve (Dec 31)
    if (_m == 12 && _d == 31) return "Counting down to a brand new year of retro gaming!";

    // ====================================================================
    // 2. STANDARD SPLASH POOL
    // ====================================================================
