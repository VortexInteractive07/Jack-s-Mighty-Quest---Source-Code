/// @function scr_intro_dialogue()
/// @description Returns the array of intro dialogue structs.
function scr_intro_dialogue() {
    return [
        { 
            name: "Jack", 
            text: "CONGRATURATION!\nYOU HAVE START THE WORK-IN-PROGRESS DEMO\nOF JACK'S MIGHTY QUEST!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 200 
        },
        { 
            name: "Jack", 
            text: "I FEEL ASLEEP AT THE FIRST SCENE!\nBUT PLEASE WAKE UP AND LISTEN CLOSELY!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 220 
        },
        { 
            name: "Jack", 
            text: "THIS SOFTWARE PROGRAM IS STILL\nUNDER HEAVY DEVELOPMENT CONSTRUCTION!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 220 
        },
        { 
            name: "Jack", 
            text: "MANY GRAPHICS, SOUND TUNES, AND GAMEPLAY\nWILL BE CHANGE OR GO AWAY IN FUTURE TIME!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 260 
        },
        { 
            name: "Jack", 
            text: "ALL YOUR BASE ARE BELONG TO US!\nSO DO NOT LEAK OR PIRATE THIS CARTRIDGE DATA!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 260 
        },
        { 
            name: "Jack", 
            text: "A REAL HERO IS SISTER WHO PROTECTS WORLD!\nTHANK YOU FOR TEST OUR PROTOTYPE GAME!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 240 
        },
        { 
            name: "Jack", 
            text: "NOW GO AND PROCEEDS TO NEXT STAGE!\nGOOD LUCK TO YOU!", 
            font: fnt_bitmap, 
            color: c_white, 
            scale: 1, 
            speed: 0.45, 
            hold: 220 
        }
    ];
}