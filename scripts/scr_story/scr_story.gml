/// @function scr_story()
/// @description Streamlined cutscene script with explicit line breaks and direct asset identifiers.
function scr_story() {
    return [
        {
            sprite: spr_celestia,
            speaker: "",
            sfx: sfx_ambient_city,
            text: "Celestia was never designed to be just another\ncrowded metropolis. Carved out of the western\nplateaus after the Great Severance, it grew into\na sanctuary of towering glass spires."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Down on the lower avenues, open-air markets\nhummed with quiet conversation. Merchants arranged\nfresh produce and children walked to school."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "It was a fragile peace bought through decades of\nsacrifice. The founders mapped these valleys to\nescape the ash and blood of older wars."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "At the helm of this society stood President\nWilliam Smith Moore and First Lady Samantha\nNicholas Johnson, balancing industrial expansion\nwith strict humanitarian laws."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Behind their public presence lay a heavy lineage.\nGrandfather Smith Moore, Grandmother Sarah, and\ngreat-grandfather Johnson laid the iron foundations."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Jack grew up hearing stories of that fame around\ndinner tables, but he turned away from high office\nto pursue machinery, grease, and circuit boards."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "He shared a high-altitude residential apartment\nin the upper ring with his wife, Charlotte, a\nbrilliant systems engineer."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Their mornings followed a familiar rhythm of\nwarm coffee, hurried blueprints, and quiet jokes\nabout local municipal regulations."
        },
        {
            sprite: -1,
            speaker: "CHARLOTTE",
            sfx: sfx_charlotte_speak,
            text: "'Jack, if you wire that espresso machine directly\ninto the main substation one more time, the building\ninspector is moving into our spare bedroom.'"
        },
        {
            sprite: -1,
            speaker: "JACK",
            sfx: sfx_jack_speak,
            text: "'Where is the pioneer spirit in step-down\ntransformers, Char? Proper coffee extraction\nrequires raw, unthrottled current.'"
        },
        {
            sprite: -1,
            speaker: "CHARLOTTE",
            sfx: sfx_charlotte_speak,
            text: "'Your stress tests give my department heart\npalpitations. Drink your cup before it plunges\nthe kitchen into total darkness.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_seismic_rumble,
            text: "A violent subterranean shockwave ripped through\nthe bedrock beneath Celestia, rattling windows\nand throwing Jack against his workbench."
        },
        {
            sprite: -1,
            speaker: "CHARLOTTE",
            sfx: sfx_charlotte_speak,
            text: "'That was not an earthquake! Jack, look at the\nterminal monitor, the entire regional power grid\njust flatlined in a single second!'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_static_glitch,
            text: "Before manual auxiliary generators could kick in,\nevery monitor flared with jagged green static.\nAn emergency override hijacked every frequency."
        },
        {
            sprite: -1,
            speaker: "VICTOR SCHADENFREUDE",
            sfx: sfx_sharp_speak,
            text: "'Good morning, citizens of Aetheria. I apologize\nfor interrupting your quaint routines. My name\nis Victor Schadenfreude, and your sanctuary is closed.'"
        },
        {
            sprite: -1,
            speaker: "VICTOR SCHADENFREUDE",
            sfx: sfx_sharp_speak,
            text: "'And to you, Jack, watch out your window. Witness\nyour family's grand legacy turn to ash. Total\nstructural erasure is my only outcome today.'"
        },
        {
            sprite: spr_charlotte_escape,
            speaker: "",
            sfx: sfx_explosion_subdued,
            text: "A heavy explosion echoed from the plaza below.\nCharlotte grabbed her tactical jacket, rushing toward\nthe corridor to secure an escape hatch."
        },
        {
            sprite: spr_vic_seek,
            speaker: "VICTOR SCHADENFREUDE",
            sfx: sfx_victor_laugh,
            text: "'Hahahahaaa! How exquisitely predictable!\nEverything is falling into place right on schedule!'"
        },
        {
            sprite: -1,
            speaker: "VICTOR SCHADENFREUDE",
            sfx: sfx_sharp_speak,
            text: "'And as for you, Jack, you stubborn fool!\nDo you genuinely believe your little tricks will\nsave you from what is coming?!'"
        },
        {
            sprite: -1,
            speaker: "VICTOR SCHADENFREUDE",
            sfx: sfx_victor_laugh,
            text: "'Hahahahahaa! Watch your world burn and savor\nthe complete helplessness of your efforts!\nMuahahahahahahaaaa!'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_screen_off,
            text: "The main feed cut to black. As Jack stepped out\ninto the hallway, the air smelled of ozone and\ncordite while emergency sirens wailed."
        },
        {
            sprite: -1,
            speaker: "JACK",
            sfx: sfx_jack_speak,
            text: "'Char, stay right beside me. We need to drop\ndown through the maintenance service shaft to reach\nthe central vault before the lockdown.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Young citizens drifted through the smoke with\nglassy, empty eyes, caught in a deep mechanical\ntrance under Victor's broadcast signal."
        },
        {
            sprite: -1,
            speaker: "CHARLOTTE",
            sfx: sfx_charlotte_speak,
            text: "'Jack! The structural bridge ahead just sheared\noff! Watch out for the falling debris!'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Jack pushed forward through thick grey smoke,\nlunging into the adjacent alleyway just as a\nfigure stumbled onto the concrete."
        },
        {
            sprite: spr_charlotte_mannequin_dust,
            speaker: "JACK",
            sfx: sfx_jack_speak,
            text: "'Charlotte! Hang on, stay with me, look at\nme right now!'"
        },
        {
            sprite: spr_charlotte_mannequin_dust,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "What he held was not flesh and breathing warmth,\nbut an articulated synthetic decoy rigged with a\ntracking beacon. Charlotte had already been taken."
        },
        {
            sprite: -1,
            speaker: "PRESIDENT MOORE",
            sfx: sfx_williams_speak,
            text: "'Jack! Reach the primary mainframe terminal\nbeneath the plaza! Shut down their neural network\nprotocol before they purge the archives!'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "First Lady Samantha Nicholas Johnson met him\namid falling slabs, pressing a reinforced tactical\nhoodie and encrypted data-pad into his hands."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_explosion_subdued,
            text: "Dr. Vic Sharp breached the chamber with automated\nenforcers, dragging President Moore away into\nthe shadows as the command floor caved in."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Kneeling alone among smoking server racks, Jack\nlet go of his panic and replaced it with cold,\ncalculated resolve. This war was personal."
        },
        {
            sprite: -1,
            speaker: "MARK",
            sfx: sfx_mark_speak,
            text: "'Biometric diagnostic complete. Stress indicators\nare stable. I am Mark, an autonomous tactical unit.\nRerouting grid power to your combat gear.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Mark stepped forward as an indispensable partner,\noperating parallel to Jessie, an elite cybersecurity\noperative keeping secure channels open."
        },
        {
            sprite: -1,
            speaker: "CHARLOTTE",
            sfx: sfx_charlotte_glitch_speak,
            text: "'Jack... take the old utility conduit. Victor's\nturret grid does not cover that blind spot. I am\nkeeping the port open from this end.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Her voice hissed and cracked through the audio\nfeed. Jack held onto every single syllable,\nrefusing to imagine her mind trapped in the core."
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Deep within Victor's restricted archives, Jack\nuncovered a tragic history of his children being\nweaponized by corrupt military contractors."
        },
        {
            sprite: -1,
            speaker: "JESSICA",
            sfx: sfx_jessica_speak,
            text: "'Jack, listen to me. I am Jessica, your sister.\nI have been fighting Victor from inside his own\nnetwork for years. We are running out of time.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Blocking the inner gateway stood Jason, Victor's\ncorrupted son, whose childhood grief had been\ntwisted into burning hatred."
        },
        {
            sprite: -1,
            speaker: "JASON",
            sfx: sfx_jason_speak,
            text: "'You and your family took everything from me!\nYou stole my life, and now you think you can\nplay the hero? I will end you right here!'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "At the threshold of the core sector, a brainwashed\ncivilian stood frozen, raising a heavy rifle while\ntrembling under the neural override command."
        },
        {
            sprite: -1,
            speaker: "MARK",
            sfx: sfx_mark_speak,
            text: "'Warning: Neural override active on civilian.\nLethal engagement guarantees safety; non-lethal\nEMP carries severe operational risk to hardware.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_dialogue_narrative,
            text: "Every choice from this point forward would decide\nthe fate of Aetheria and define the person Jack\nwould become when the smoke cleared."
        },
        {
            sprite: -1,
            speaker: "JACK",
            sfx: sfx_jack_speak,
            text: "'We do not leave innocent people behind to rot\nin his machine. Not Charlotte, and not these kids.\nMark, charge the non-lethal EMP.'"
        },
        {
            sprite: -1,
            speaker: "",
            sfx: sfx_emp_charge,
            text: "The final door hissed open, revealing the humming\nexpanse of the central core. The battle for\nAetheria had only just begun."
        }
    ];
}