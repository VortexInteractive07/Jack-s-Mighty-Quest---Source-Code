                { time: 8.072,  text: "Vaaeh feshun, nulaa hithugaa!" },
                { time: 12.157, text: "Rey kanda gais," },
                { time: 14.099, text: "Iru osseygen dhaashey," },
                { time: 16.523, text: "Ahmed ge preethi," },
