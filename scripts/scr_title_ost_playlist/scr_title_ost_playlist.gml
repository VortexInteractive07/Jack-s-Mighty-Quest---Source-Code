/// @function scr_title_ost_playlist()
/// @description Returns an array of track structs containing sound resource and display title.
function scr_title_ost_playlist() {
    return [
        { sound: mus_raalhehge_monaigaa, title: "Raalhehge Monaigaa" },
        { sound: mus_alhavaa,            title: "Alhavaa" },
        { sound: mus_ranga_dhun_yeh,      title: "Ranga Dhun Yeh" },
        { sound: mus_rey_kanda_gais,     title: "Rey Kanda Gais" },
		{ sound: mus_moodhu_raalhahge_taalam,     title: "Moodhu Ralhahge Taalam" },
		{ sound: mus_mage_maaladivaina,     title: "Mage Maaladivaina (Sinhala)" }
    ];
}