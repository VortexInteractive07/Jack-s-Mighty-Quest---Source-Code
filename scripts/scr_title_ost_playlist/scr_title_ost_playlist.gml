		{ sound: mus_dhaaru_ofu_maaiy,   title: "Dhaaru Ofu Maaiy",            composer: "Naifaru Dhohokko" },
        { sound: mus_ranga_dhun_yeh,     title: "Ranga Dhun Yeh",              composer: "Pixel" },
		{ sound: mus_monaigaa_alhavaa,   title: "Monaigaa Alhavaa",            composer: "Pixel" },
